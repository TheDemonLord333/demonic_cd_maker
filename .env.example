# Demonic FLAC Studio — environment configuration
# Copy this file to `.env` and adjust as needed.
# Node itself only ever needs to be reachable on 127.0.0.1 — Nginx handles
# the public HTTPS endpoint (see nginx/demonic-flac-studio.conf).

# --- Network ---------------------------------------------------------------
PORT=3008
HOST=127.0.0.1
NODE_ENV=production

# Set to "true" only if Nginx (or another reverse proxy) sits in front of
# this app and sends X-Forwarded-* headers — needed for correct rate-limit
# client identification.
TRUST_PROXY=true

# --- Uploads -----------------------------------------------------------
# Maximum size of a single uploaded FLAC file, in megabytes.
MAX_FILE_SIZE_MB=150

# Maximum size of a single uploaded cover image, in megabytes.
MAX_COVER_SIZE_MB=15

# Maximum number of FLAC files accepted in one upload request.
MAX_FILES_PER_UPLOAD=30

# --- Temp sessions / cleanup --------------------------------------------
# Directory used for per-session working files. Defaults to ./temp.
TEMP_DIR=./temp

# How long (minutes) an idle session's files are kept before automatic
# cleanup deletes them.
SESSION_TTL_MINUTES=60

# How often (minutes) the cleanup sweep runs.
CLEANUP_INTERVAL_MINUTES=5

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
UPLOAD_RATE_LIMIT_MAX=60
