{
  "name": "demonic-flac-studio",
  "version": "1.0.0",
  "description": "Demonic FLAC Studio - a dark, production-ready web app for editing FLAC metadata, Vorbis comments and embedded cover art without re-encoding audio.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart demonic-flac-studio",
    "pm2:stop": "pm2 stop demonic-flac-studio",
    "pm2:logs": "pm2 logs demonic-flac-studio"
  },
  "keywords": [
    "flac",
    "metadata",
    "vorbis-comment",
    "tagging",
    "audio"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "archiver": "^7.0.1",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1"
  }
}
